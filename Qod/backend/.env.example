# Copy to .env (never commit real values).
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
APP_ENV=development

# PostgreSQL only. Either one DATABASE_URL or the discrete DB_* variables.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DB_NAME=seasons_cake
DB_USER=seasons
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# The SPA sends an Idempotency-Key header on sales/payments/refunds; it is allowed by
# settings.py in addition to the django-cors-headers defaults. Do not remove that entry.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
FRONTEND_ORIGIN=

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
THROTTLE_ANON=120/min
THROTTLE_USER=2000/hour
THROTTLE_LOGIN=10/min
THROTTLE_PUBLIC_WRITE=20/hour

# Seed/demo credentials (only read by management commands; none are stored here).
SEED_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=Owner
ADMIN_PASSWORD=
