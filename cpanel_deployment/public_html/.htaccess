# ==============================================================================
# SEASONS CAKE — cPanel Apache .htaccess (Root: public_html)
# ==============================================================================
# Handles:
# 1. SSL / HTTPS Enforcement
# 2. Routing /api, /admin, /media to Django Passenger WSGI
# 3. Client-Side Routing for React SPA (index.html fallback)
# 4. Gzip / Deflate compression and caching headers
# ==============================================================================

RewriteEngine On
RewriteBase /

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Route Static Media and Uploads directly
RewriteCond %{REQUEST_URI} ^/media/(.*)$
RewriteCond %{DOCUMENT_ROOT}/media/$1 -f
RewriteRule ^media/(.*)$ /media/$1 [L]

# 3. Passenger / Python App Pass-Through for API & Admin
# If you are routing /api and /admin to a Passenger WSGI app running in a subfolder or via ProxyPass:
RewriteCond %{REQUEST_URI} ^/api/ [OR]
RewriteCond %{REQUEST_URI} ^/admin/
RewriteRule ^ - [L]

# 4. BMS Subfolder Bypass (Let /bms have its own rules in public_html/bms/.htaccess)
RewriteCond %{REQUEST_URI} ^/bms/
RewriteRule ^ - [L]

# 5. Public Website SPA Fallback (HTML5 pushState)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# 6. Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 7. Browser Cache Headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
</IfModule>
